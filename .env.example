# Puerto para el servidor HTTP
PORT=5173

# Activa "true" para usar datos simulados sin conectar con Google (modo demo)
USE_MOCK_DATA=false

# Credenciales del servicio de Google
# Copia el correo del service account y la clave privada del archivo JSON.
GOOGLE_CLIENT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Configuración de Google Sheets
GOOGLE_SHEETS_ID=1UtO3_eMR2pmWLl4e1BCZ_2LhNeVBro0bBGhGdmtslBQ
# Rango que contiene la lista de eventos (columna A: nombre del evento, columna B: presupuesto)
GOOGLE_SHEETS_EVENTS_RANGE=eventos!A2:B
# Rango donde se anexarán los registros de comprobantes (columnas: evento, concepto, valor, link)
GOOGLE_SHEETS_LOG_RANGE=registro!A2:D

# Carpeta de Google Drive donde se guardarán las imágenes
GOOGLE_DRIVE_FOLDER_ID=1L3tBSDVz70ViiaVA-KuumOR-5hWxANWZ

# Máximo de bytes permitidos para los archivos base64 (ej. 5 MB)
MAX_IMAGE_SIZE=5242880
